// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  analyticsProjectionId String?
  timeZone              String?
  analyticsProjections  WorkoutAnalyticsProjection[]
  trainingEvents        TrainingEvent[]
  personalRecords       PersonalRecord[]
  id                    String                       @id @default(uuid())
  email                 String                       @unique
  password              String? // Made optional for Supabase migration
  name                  String
  lastName              String?
  avatarUrl             String?
  age                   Int?
  sex                   Sex?
  weight                Float?
  height                Float?
  supabaseUserId        String?                      @unique // Link to Supabase user
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  refreshTokens         RefreshToken[]
  weightUnit            WeightUnit                   @default(KG)
  routines              Routine[]
  workoutSessions       WorkoutSession[]
  following             UserFollow[]                 @relation("UserFollowing")
  followers             UserFollow[]                 @relation("UserFollowers")
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("Follow")
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  issuedAt  DateTime @default(now())
  expiresAt DateTime
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt  DateTime @default(now())
  expiresAt DateTime
}

// Weight unit preference per user
enum WeightUnit {
  KG
  LB
}

// Biological sex of user
enum Sex {
  MALE
  FEMALE
}

// Muscle groups for exercise targeting
enum MuscleGroup {
  PECTORAL
  LATISSIMUS_DORSI
  TRAPEZIUS
  REAR_DELTOIDS
  ERECTOR_SPINAE
  TERES_MAJOR_MINOR
  ANTERIOR_DELTOIDS
  MEDIAL_DELTOIDS
  BICEPS
  FOREARMS
  TRICEPS
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE
  ADDUCTOR
}

// Catalog of exercises selectable when building routines
model Exercise {
  id               String            @id @default(uuid())
  name             String            @unique
  primaryMuscles   MuscleGroup[] // Primary muscle movers (counts as 1.0 for volume)
  secondaryMuscles MuscleGroup[] // Secondary muscle movers (counts as 0.5 for volume)
  equipment        String // e.g., "barbell", "dumbbell", "bodyweight"
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  routineExercises RoutineExercise[]
  setLogs          SetLog[]
}

// A training routine owned by a single user (non-shareable for now)
model Routine {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  isPeriodized    Boolean          @default(false)
  isFavorite      Boolean          @default(false)
  isCompleted     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  days            RoutineDay[]
  workoutSessions WorkoutSession[]

  @@index([userId, isFavorite])
  @@index([userId, isCompleted])
}

// A training day configuration inside a routine
model RoutineDay {
  id              String            @id @default(uuid())
  routineId       String
  routine         Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dayOfWeek       Int // 0=Sun .. 6=Sat
  order           Int               @default(0)
  exercises       RoutineExercise[]
  workoutSessions WorkoutSession[]

  @@unique([routineId, dayOfWeek])
}

// One exercise entry in a routine day
model RoutineExercise {
  id                 String               @id @default(uuid())
  routineDayId       String
  routineDay         RoutineDay           @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exerciseId         String
  exercise           Exercise             @relation(fields: [exerciseId], references: [id])
  order              Int                  @default(0)
  restSeconds        Int                  @default(60)
  note               String? // User note for the exercise in this routine
  // Progression configuration per exercise
  progressionScheme  ProgressionScheme    @default(NONE)
  minWeightIncrement Float                @default(2.5)
  sets               RoutineExerciseSet[]
  setLogs            SetLog[]
}

// Set configuration for a routine exercise
model RoutineExerciseSet {
  id                String          @id @default(uuid())
  routineExerciseId String
  routineExercise   RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  // Rep prescription can be a fixed amount or a range
  repType           RepType         @default(FIXED)
  reps              Int?
  minReps           Int?
  maxReps           Int?
  weight            Float?
  rir               Int?

  @@unique([routineExerciseId, setNumber])
}

// How reps are prescribed for a set
enum RepType {
  FIXED
  RANGE
}

// How weight progression should be applied for an exercise
enum ProgressionScheme {
  NONE // no progression applied
  DOUBLE_PROGRESSION // progress when all sets hit target (formerly DYNAMIC)
  DYNAMIC_DOUBLE_PROGRESSION // progress per set when that set hits target (formerly DYNAMIC_DOUBLE)
}

// Tracking a user's execution of a specific RoutineDay
enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

model WorkoutSession {
  sourceRoutineId    String?
  sourceRoutineDayId String?
  totalVolumeKg      Float?
  completedSets      Int?
  snapshot           WorkoutSessionSnapshot?
  id                 String                  @id @default(uuid())
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId          String?
  routine            Routine?                @relation(fields: [routineId], references: [id], onDelete: SetNull)
  routineDayId       String?
  routineDay         RoutineDay?             @relation(fields: [routineDayId], references: [id], onDelete: SetNull)
  status             WorkoutSessionStatus    @default(IN_PROGRESS)
  startedAt          DateTime                @default(now())
  endedAt            DateTime?
  durationSec        Int?
  notes              String?
  setLogs            SetLog[]
  // Updated whenever a set log is created/updated/deleted (activity heartbeat)
  lastActivityAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, startedAt])
  @@index([userId, id])
  @@index([userId, status, endedAt, id], map: "workout_analytics_cursor_status")
  @@index([lastActivityAt])
}

// A log of an executed set during a workout session
model SetLog {
  sourceRoutineExerciseId String?
  id                      String           @id @default(uuid())
  sessionId               String
  session                 WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  routineExerciseId       String?
  routineExercise         RoutineExercise? @relation(fields: [routineExerciseId], references: [id], onDelete: SetNull)
  exerciseId              String
  exercise                Exercise         @relation(fields: [exerciseId], references: [id])
  setNumber               Int
  reps                    Int?
  weight                  Float?
  rpe                     Float?
  isCompleted             Boolean          @default(false)
  completedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, routineExerciseId, setNumber])
  @@unique([sessionId, sourceRoutineExerciseId, setNumber])
  @@index([sessionId])
}

model WorkoutSessionSnapshot {
  sessionId     String         @id
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schemaVersion Int            @default(1)
  payload       Json
  provenance    String
  createdAt     DateTime       @default(now())
}

model TrainingEvent {
  id            String            @id @default(uuid())
  eventKey      String            @unique
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String
  type          TrainingEventType
  occurredAt    DateTime
  schemaVersion Int               @default(1)
  payload       Json

  @@index([userId, occurredAt, id])
}

enum TrainingEventType {
  SESSION_COMPLETED
  PERSONAL_RECORD
}

model PersonalRecord {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId   String
  exerciseName String
  sessionId    String
  setLogId     String
  weight       Float
  reps         Int
  estimated1rm Float
  achievedAt   DateTime

  @@unique([userId, exerciseId])
  @@index([userId, achievedAt(sort: Desc)])
}

model WorkoutAnalyticsProjection {
  id                String                    @id @default(uuid())
  userId            String
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemaVersion     Int                       @default(1)
  timeZone          String
  state             String                    @default("BUILDING")
  active            Boolean                   @default(false)
  totalVolumeKg     Float                     @default(0)
  completedSessions Int                       @default(0)
  completedSets     Int                       @default(0)
  lastTrainingDate  String?
  currentRun        Int                       @default(0)
  bestRun           Int                       @default(0)
  checksum          String                    @default("")
  createdAt         DateTime                  @default(now())
  rollups           WorkoutRollup[]
  muscleRollups     WorkoutMuscleRollup[]
  job               AnalyticsBackfillJob?
  recordFrontier    AnalyticsRecordFrontier[]

  @@index([userId, createdAt(sort: Desc)])
}

model WorkoutRollup {
  projectionId  String
  projection    WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  period        String
  date          String
  volumeKg      Float                      @default(0)
  completedSets Int                        @default(0)
  sessions      Int                        @default(0)
  activeDays    Int                        @default(0)

  @@id([projectionId, period, date])
}

model AnalyticsRecordFrontier {
  projectionId String
  projection   WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  exerciseId   String
  weight       Float
  reps         Int

  @@id([projectionId, exerciseId])
}

model WorkoutMuscleRollup {
  projectionId  String
  projection    WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  period        String
  date          String
  muscle        String
  volumeKg      Float                      @default(0)
  completedSets Float                      @default(0)

  @@id([projectionId, period, date, muscle])
}

model AnalyticsBackfillJob {
  id                      String                     @id @default(uuid())
  projectionId            String                     @unique
  projection              WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  state                   String                     @default("PENDING")
  cursorEndedAt           DateTime?
  cursorSessionId         String?
  snapshotCursorSessionId String?
  snapshotsComplete       Boolean                    @default(false)
  attempts                Int                        @default(0)
  error                   String?
  approximatedSessions    Int                        @default(0)
  processedSessions       Int                        @default(0)
  updatedAt               DateTime                   @updatedAt

  @@index([state, updatedAt])
}
