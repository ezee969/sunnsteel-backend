// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  analyticsProjectionId      String?
  timeZone                   String?
  analyticsProjections       WorkoutAnalyticsProjection[]
  trainingEvents             TrainingEvent[]
  personalRecords            PersonalRecord[]
  id                         String                       @id @default(uuid())
  email                      String                       @unique
  username                   String                       @unique @db.VarChar(30)
  name                       String
  lastName                   String?
  avatarUrl                  String?
  bio                        String?                      @db.VarChar(500)
  location                   String?                      @db.VarChar(100)
  trainingGoals              TrainingGoal[]               @default([])
  trainingExperienceLevel    TrainingExperienceLevel?
  trainingDisciplines        TrainingDiscipline[]         @default([])
  preferredTrainingStyle     PreferredTrainingStyle?
  age                        Int?
  sex                        Sex?
  weight                     Float?
  height                     Float?
  supabaseUserId             String?                      @unique // Link to Supabase user
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  weightUnit                 WeightUnit                   @default(KG)
  bioVisibility              ProfileVisibility            @default(PRIVATE)
  locationVisibility         ProfileVisibility            @default(PRIVATE)
  trainingIdentityVisibility ProfileVisibility            @default(PRIVATE)
  historyVisibility          ProfileVisibility            @default(PRIVATE)
  recordsVisibility          ProfileVisibility            @default(PRIVATE)
  routinesVisibility         ProfileVisibility            @default(PRIVATE)
  achievementsVisibility     ProfileVisibility            @default(PRIVATE)
  bodyMetricsVisibility      ProfileVisibility            @default(PRIVATE)
  discoverableByName         Boolean                      @default(true)
  discoverableByUsername     Boolean                      @default(true)
  discoverableByContacts     Boolean                      @default(false)
  // PREF-05: sessions without a new best before the plateau watch flags a
  // lift; bounded by PLATEAU_MIN_SESSIONS_MIN/MAX (checked in the migration).
  plateauMinSessions         Int                          @default(4)
  routines                   Routine[]
  workoutSessions            WorkoutSession[]
  trainingLocations          TrainingLocationPreference[]
  following                  UserFollow[]                 @relation("UserFollowing")
  followers                  UserFollow[]                 @relation("UserFollowers")
  blocksMade                 UserBlock[]                  @relation("BlocksMade")
  blocksReceived             UserBlock[]                  @relation("BlocksReceived")
  reportsFiled               MemberReport[]
  clonedRoutines             Routine[]                    @relation("RoutineCloneAuthors")
  favoriteExercises          UserFavoriteExercise[]
  starredExercises           StarredExercise[]
  sessionShares              SessionShare[]
  sessionCorrections         SessionCorrection[]
  routineShares              RoutineShare[]
  measurableGoals            MeasurableGoal[]
  scheduleOverrides          ScheduleOverride[]
  notifications              Notification[]               @relation("NotificationRecipient")
  notificationsAsActor       Notification[]               @relation("NotificationActor")
  featuredProfileItems       FeaturedProfileItem[]
  // NOTIF-05: per-category delivery switches, a local quiet window and the
  // NOTIF-04 reminder time, all evaluated in `timeZone`. A null reminder
  // minute means reminders are off; choosing a time is what opts in.
  notifyRestAlert            Boolean                      @default(true)
  notifyTrainingReminder     Boolean                      @default(true)
  notifyStreakAtRisk         Boolean                      @default(true)
  quietHoursStartMinute      Int?
  quietHoursEndMinute        Int?
  reminderMinuteOfDay        Int?
  pushSubscriptions          PushSubscription[]
  scheduledPushes            ScheduledPush[]
  activitySharingDefaults    ActivitySharingDefault[]
  activityEntryOverrides     ActivityEntryOverride[]
  activityReactionsMade      ActivityEntryReaction[]      @relation("ActivityReactionsMade")
  activityReactionsReceived  ActivityEntryReaction[]      @relation("ActivityReactionsReceived")
  activityCommentsMade       ActivityComment[]            @relation("ActivityCommentsMade")
  activityCommentsReceived   ActivityComment[]            @relation("ActivityCommentsReceived")
  trainingPartnerRequests    TrainingPartnership[]         @relation("TrainingPartnershipRequester")
  trainingPartnerInvites     TrainingPartnership[]         @relation("TrainingPartnershipRecipient")
  trainingPartnerGrants      TrainingPartnerGrant[]        @relation("TrainingPartnerGrantor")
  // TRUST-04: the whole authorization model for moderation. There is one
  // moderator, so a flag is the honest shape; a roles table would be a
  // subsystem built for a second moderator who does not exist.
  isModerator                Boolean                      @default(false)
  /// TRUST-04: set by HIDE_SUBJECT. The account keeps everything it owns and
  /// still reads its own profile; nobody else can reach it.
  moderationHiddenAt         DateTime?
  moderationActions          ModerationAction[]           @relation("ModerationActor")
  reportsResolved            MemberReport[]               @relation("ReportResolver")
}

/// PROF-08 adds ROUTINE: a shared routine is a fourth kind of featured item,
/// resolved through the same ROUT-04 rule as any other read of a routine.
enum FeaturedProfileItemKind {
  RECORD
  ACHIEVEMENT
  RANK
  ROUTINE
}

model FeaturedProfileItem {
  id          String                  @id @default(uuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        FeaturedProfileItemKind
  referenceId String                  @db.VarChar(100)
  position    Int
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([userId, position])
  @@unique([userId, kind, referenceId])
}

model TrainingLocationPreference {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  isDefault           Boolean  @default(false)
  barWeightKg         Float
  availablePlatePairs Json     @default("[]")
  equipment           String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, isDefault])
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("Follow")
}

/// PROF-10: a symmetric block. One row, from the blocker to the blocked, but
/// every read treats it as mutual: neither account sees the other anywhere.
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

enum TrainingPartnershipStatus {
  PENDING
  ACTIVE
}

/// SOC-08: one explicit, mutual relationship. `pairKey` is the two sorted
/// account ids joined by `:`, so the same pair cannot create a reverse request.
model TrainingPartnership {
  id          String                    @id @default(uuid())
  pairKey     String                    @unique @db.VarChar(73)
  requesterId String
  recipientId String
  status      TrainingPartnershipStatus @default(PENDING)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  acceptedAt  DateTime?
  requester   User                      @relation("TrainingPartnershipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User                      @relation("TrainingPartnershipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  grants      TrainingPartnerGrant[]

  @@index([requesterId, status, createdAt])
  @@index([recipientId, status, createdAt])
}

/// Each active member grants access independently. Missing rows and every
/// false field deny access; accepting a request creates both rows atomically.
model TrainingPartnerGrant {
  partnershipId String
  grantorId     String
  schedule      Boolean              @default(false)
  progress      Boolean              @default(false)
  activity      Boolean              @default(false)
  routines      Boolean              @default(false)
  encouragement Boolean              @default(false)
  updatedAt     DateTime             @updatedAt
  partnership   TrainingPartnership  @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  grantor       User                 @relation("TrainingPartnerGrantor", fields: [grantorId], references: [id], onDelete: Cascade)

  @@id([partnershipId, grantorId])
  @@index([grantorId])
}

/// PROF-10: a recorded report. TRUST-04 owns the queue, the review actions and
/// the enforcement record; nothing here reads these rows yet, which is why the
/// response never implies that anything does.
model MemberReport {
  id           String            @id @default(uuid())
  reporterId   String
  reporter     User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  subjectKind  ReportSubjectKind
  /// A member id, a routine id, or a session share token.
  subjectId    String
  reason       ReportReason
  details      String?           @db.VarChar(500)
  createdAt    DateTime          @default(now())
  /// TRUST-04. OPEN until a moderator dismisses it or acts on the subject.
  /// It is denormalised from the enforcement records on purpose -- the queue
  /// pages on it -- and only ever written in the same transaction as the
  /// ModerationAction row that explains it.
  status       ReportStatus      @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?             @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([reporterId, createdAt])
  @@index([subjectKind, subjectId])
  @@index([status, createdAt, id])
  @@index([subjectKind, subjectId, status])
}

/// TRUST-04: one moderator power, used once. Rows are appended and never
/// updated or deleted -- undoing a hide appends a RESTORE_SUBJECT record
/// rather than editing the HIDE_SUBJECT one, which is the only way "the
/// record is never editable" and "a mistaken hide is not permanent" can both
/// hold. VIEW_SUBJECT is recorded for the same reason as the rest: reading
/// somebody's reported content is a power, and an unlogged read is the one
/// nobody could audit afterwards.
model ModerationAction {
  id          String               @id @default(uuid())
  moderatorId String
  moderator   User                 @relation("ModerationActor", fields: [moderatorId], references: [id], onDelete: Cascade)
  kind        ModerationActionKind
  /// The report the action was taken from, kept even if the report is gone.
  reportId    String?
  subjectKind ReportSubjectKind
  /// The resolved subject: a member id, a routine id or a share token.
  subjectId   String
  note        String?              @db.VarChar(500)
  createdAt   DateTime             @default(now())

  @@index([createdAt, id])
  @@index([subjectKind, subjectId, createdAt])
  @@index([reportId])
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum ModerationActionKind {
  VIEW_SUBJECT
  DISMISS_REPORT
  HIDE_SUBJECT
  RESTORE_SUBJECT
}

enum ReportSubjectKind {
  MEMBER
  ROUTINE
  SESSION
  COMMENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  UNSAFE_ADVICE
  SEXUAL_CONTENT
  OTHER
}

// Weight unit preference per user
enum WeightUnit {
  KG
  LB
}

// Biological sex of user
enum Sex {
  MALE
  FEMALE
}

enum ProfileVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum TrainingGoal {
  STRENGTH
  MUSCLE_GROWTH
  FAT_LOSS
  ENDURANCE
  GENERAL_FITNESS
  ATHLETIC_PERFORMANCE
  MOBILITY
}

enum TrainingExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingDiscipline {
  BODYBUILDING
  POWERLIFTING
  WEIGHTLIFTING
  CALISTHENICS
  STRONGMAN
  HYBRID_TRAINING
  GENERAL_STRENGTH
}

enum PreferredTrainingStyle {
  FULL_BODY
  UPPER_LOWER
  PUSH_PULL_LEGS
  BODY_PART_SPLIT
  CIRCUIT
}

// Muscle groups for exercise targeting
enum MuscleGroup {
  PECTORAL
  LATISSIMUS_DORSI
  TRAPEZIUS
  REAR_DELTOIDS
  ERECTOR_SPINAE
  TERES_MAJOR_MINOR
  ANTERIOR_DELTOIDS
  MEDIAL_DELTOIDS
  BICEPS
  FOREARMS
  TRICEPS
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE
  ADDUCTOR
}

// EXER-09: how an exercise moves. Mirrors MOVEMENT_PATTERNS in @sunsteel/contracts.
enum MovementPattern {
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  SQUAT
  HINGE
  LUNGE
  CHEST_FLY
  SHOULDER_ABDUCTION
  SHOULDER_FLEXION
  SHOULDER_HORIZONTAL_ABDUCTION
  SHOULDER_EXTENSION
  SCAPULAR_ELEVATION
  ELBOW_FLEXION
  ELBOW_EXTENSION
  KNEE_EXTENSION
  KNEE_FLEXION
  HIP_EXTENSION
  PLANTAR_FLEXION
  CORE_FLEXION
  CORE_ROTATION
  CORE_STABILITY
}

enum ExerciseMechanic {
  COMPOUND
  ISOLATION
}

// Catalog of exercises selectable when building routines
model Exercise {
  id                String                 @id @default(uuid())
  name              String                 @unique
  primaryMuscles    MuscleGroup[] // Primary muscle movers (counts as 1.0 for volume)
  secondaryMuscles  MuscleGroup[] // Secondary muscle movers (counts as 0.5 for volume)
  equipment         String // e.g., "barbell", "dumbbell", "bodyweight"
  // EXER-09 metadata; the catalog values live in prisma/exercise-catalog.ts.
  movementPattern   MovementPattern?
  mechanic          ExerciseMechanic?
  equipmentRequired String[]               @default([]) // EXERCISE_EQUIPMENT values
  substitutionGroup String?
  instructions      String[]               @default([]) // EXER-03 content
  mediaUrl          String? // EXER-04 licensed media
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  routineExercises  RoutineExercise[]
  setLogs           SetLog[]
  favoritedBy       UserFavoriteExercise[]
  starredBy         StarredExercise[]
  measurableGoals   MeasurableGoal[]

  @@index([movementPattern])
  @@index([substitutionGroup])
}

enum MeasurableGoalType {
  WEEKLY_SESSIONS
  WEEKLY_VOLUME
  STREAK_DAYS
  EXERCISE_ESTIMATED_1RM
  BODY_WEIGHT
}

enum MeasurableGoalDirection {
  AT_LEAST
  AT_MOST
}

model MeasurableGoal {
  id          String                  @id @default(uuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        MeasurableGoalType
  targetValue Float
  direction   MeasurableGoalDirection @default(AT_LEAST)
  exerciseId  String?
  exercise    Exercise?               @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([exerciseId])
}

model UserFavoriteExercise {
  userId     String
  exerciseId String
  position   Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
  @@index([userId, position])
  @@index([exerciseId])
}

// EXER-07: private stars that order the owner's exercise pickers. Separate
// from UserFavoriteExercise, the public training-identity favorites.
model StarredExercise {
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
  @@index([userId, createdAt])
  @@index([exerciseId])
}

// A training routine owned by a single user (non-shareable for now)
model Routine {
  id                  String                   @id @default(uuid())
  userId              String
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  isPeriodized        Boolean                  @default(false)
  isFavorite          Boolean                  @default(false)
  isCompleted         Boolean                  @default(false)
  // ROUT-11: WEEKLY days carry a weekday; ROTATION days run in `order`.
  scheduleMode        RoutineScheduleMode      @default(WEEKLY)
  // SCHED-07: planned rest weekdays of a weekly routine (never training days).
  restDays            Int[]                    @default([])
  // SCHED-06: weekdays a ROTATION routine trains on; empty means any day, undated.
  rotationWeekdays    Int[]                    @default([])
  // ROUT-04: who may read this routine. The account-level PROF-06 routines
  // rule is the upper bound; this can only narrow it, never widen it.
  visibility          RoutineVisibility        @default(PRIVATE)
  // ROUT-08: the last version number handed out, so deleted numbers are never reused.
  lastVersionNumber   Int                      @default(0)
  // ROUT-07: owner-declared claims about the programme. They reuse the
  // PROF-05 enums but belong to the routine, not to its author: a person's
  // training identity is not evidence of what their routine is for.
  goal                TrainingGoal?
  experienceLevel     TrainingExperienceLevel?
  // ROUT-06: what this routine was cloned from. Both are SET NULL rather than
  // cascade, because deleting the source must not delete somebody else's copy;
  // the clone then still says it was cloned and no longer says from what.
  clonedFromRoutineId String?
  clonedFromRoutine   Routine?                 @relation("RoutineClones", fields: [clonedFromRoutineId], references: [id], onDelete: SetNull)
  clones              Routine[]                @relation("RoutineClones")
  clonedFromUserId    String?
  clonedFromUser      User?                    @relation("RoutineCloneAuthors", fields: [clonedFromUserId], references: [id], onDelete: SetNull)
  clonedAt            DateTime?
  // SOC-03: when this routine last became visible to anyone (PRIVATE to
  // FOLLOWERS or PUBLIC). Null on routines shared before SOC-03, which
  // therefore produce no activity entry rather than an invented date.
  sharedAt            DateTime?
  /// TRUST-04: set by HIDE_SUBJECT. `canViewRoutine` refuses it to everyone
  /// but the owner before it asks anything else; the routine, its days, its
  /// versions and its links are untouched.
  moderationHiddenAt  DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  days                RoutineDay[]
  workoutSessions     WorkoutSession[]
  versions            RoutineVersion[]
  trainingBlocks      RoutineTrainingBlock[]
  shares              RoutineShare[]
  scheduleOverrides   ScheduleOverride[]

  @@index([userId, isFavorite])
  @@index([userId, isCompleted])
  @@index([userId, sharedAt])
  // Created by 20260918140000_blocks_reports_lineage and
  // 20260919100000_routine_classification but never declared, so every later
  // generated migration proposed dropping them. Declaring them ends the drift.
  @@index([clonedFromRoutineId])
  @@index([goal])
  @@index([experienceLevel])
}

/// ROUT-04. PRIVATE is the default and today's behaviour for every routine.
enum RoutineVisibility {
  PRIVATE
  FOLLOWERS
  PUBLIC
}

enum RoutineScheduleMode {
  WEEKLY
  ROTATION
}

// ROUT-08: an immutable copy of a routine's whole setup (contracts
// `RoutineVersionSetup`), saved on purpose or just before a restore.
model RoutineVersion {
  id                    String             @id @default(uuid())
  routineId             String
  routine               Routine            @relation(fields: [routineId], references: [id], onDelete: Cascade)
  // 1, 2, 3… per routine, never reused after a deletion.
  number                Int
  name                  String?            @db.VarChar(60)
  kind                  RoutineVersionKind @default(SAVED)
  // BEFORE_RESTORE only: the number of the version that was restored.
  restoredVersionNumber Int?
  setup                 Json
  createdAt             DateTime           @default(now())
  trainingBlockRevisions RoutineTrainingBlock[]

  @@unique([routineId, number])
}

// ROUT-09: immutable revisions of a named, dated routine setup. Exactly one
// row per series has supersededAt = null; older rows remain durable history.
model RoutineTrainingBlock {
  id                    String                         @id @default(uuid())
  routineId             String
  routine               Routine                        @relation(fields: [routineId], references: [id], onDelete: Cascade)
  seriesId              String
  revision              Int
  name                  String                         @db.VarChar(60)
  startDate             String                         @db.VarChar(10)
  endDate               String                         @db.VarChar(10)
  setup                 Json
  sourceKind            RoutineTrainingBlockSourceKind
  sourceVersionId       String?
  sourceVersion         RoutineVersion?                @relation(fields: [sourceVersionId], references: [id], onDelete: SetNull)
  sourceVersionNumber   Int?
  sourceVersionName     String?                        @db.VarChar(60)
  supersededAt          DateTime?
  createdAt             DateTime                       @default(now())
  // ROUT-15: the revision's working copy, which its sessions log against and
  // progression advances. Superseded revisions keep theirs for history.
  days                  RoutineDay[]

  @@unique([seriesId, revision])
  @@index([routineId, supersededAt, startDate])
  @@index([sourceVersionId])
}

enum RoutineTrainingBlockSourceKind {
  CURRENT_ROUTINE
  SAVED_VERSION
}

enum RoutineVersionKind {
  SAVED
  BEFORE_RESTORE
}

// SCHED-04: the schedule-instance model — per-date overrides of a routine's
// plan, kept by calendar date (YYYY-MM-DD) because routine edits replace the
// days. MOVE puts one weekly occurrence on `toDate`.
model ScheduleOverride {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId String
  routine   Routine              @relation(fields: [routineId], references: [id], onDelete: Cascade)
  date      String               @db.VarChar(10)
  kind      ScheduleOverrideKind @default(MOVE)
  toDate    String?              @db.VarChar(10)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([routineId, date])
  @@index([userId, date])
  @@index([userId, toDate])
}

enum ScheduleOverrideKind {
  MOVE
  // SCHED-05: the occurrence is skipped on purpose; `toDate` is null.
  SKIP
}

// A training day configuration inside a routine
model RoutineDay {
  id              String            @id @default(uuid())
  routineId       String
  routine         Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dayOfWeek       Int? // 0=Sun .. 6=Sat on WEEKLY routines; null on ROTATION
  name            String?           @db.VarChar(40)
  order           Int               @default(0)
  exercises       RoutineExercise[]
  workoutSessions WorkoutSession[]
  // ROUT-15: set on a training block's working copy of its setup, null on the
  // routine's baseline days. Every baseline read filters on null; weekday
  // uniqueness is two partial unique indexes (baseline per routine, block
  // per block) created in 20260923210000_training_block_execution, because
  // Prisma cannot declare a partial index.
  trainingBlockId String?
  trainingBlock   RoutineTrainingBlock? @relation(fields: [trainingBlockId], references: [id], onDelete: Cascade)

  @@index([routineId, trainingBlockId])
  @@index([trainingBlockId])
}

// One exercise entry in a routine day
model RoutineExercise {
  id                 String               @id @default(uuid())
  routineDayId       String
  routineDay         RoutineDay           @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exerciseId         String
  exercise           Exercise             @relation(fields: [exerciseId], references: [id])
  order              Int                  @default(0)
  restSeconds        Int                  @default(60)
  note               String? // User note for the exercise in this routine
  // Progression configuration per exercise
  progressionScheme  ProgressionScheme    @default(NONE)
  minWeightIncrement Float                @default(2.5)
  sets               RoutineExerciseSet[]
  setLogs            SetLog[]
}

// Set configuration for a routine exercise
model RoutineExerciseSet {
  id                String          @id @default(uuid())
  routineExerciseId String
  routineExercise   RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  // Rep prescription can be a fixed amount or a range
  repType           RepType         @default(FIXED)
  reps              Int?
  minReps           Int?
  maxReps           Int?
  weight            Float?
  rir               Int?

  @@unique([routineExerciseId, setNumber])
}

// How reps are prescribed for a set
enum RepType {
  FIXED
  RANGE
}

// How weight progression should be applied for an exercise
enum ProgressionScheme {
  NONE // no progression applied
  DOUBLE_PROGRESSION // progress when all sets hit target (formerly DYNAMIC)
  DYNAMIC_DOUBLE_PROGRESSION // progress per set when that set hits target (formerly DYNAMIC_DOUBLE)
}

// Tracking a user's execution of a specific RoutineDay
enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

model WorkoutSession {
  sourceRoutineId       String?
  sourceRoutineDayId    String?
  totalVolumeKg         Float?
  completedSets         Int?
  snapshot              WorkoutSessionSnapshot?
  id                    String                  @id @default(uuid())
  userId                String
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId             String?
  routine               Routine?                @relation(fields: [routineId], references: [id], onDelete: SetNull)
  routineDayId          String?
  routineDay            RoutineDay?             @relation(fields: [routineDayId], references: [id], onDelete: SetNull)
  status                WorkoutSessionStatus    @default(IN_PROGRESS)
  startedAt             DateTime                @default(now())
  endedAt               DateTime?
  durationSec           Int?
  notes                 String?
  setLogs               SetLog[]
  // Updated whenever a set log is created/updated/deleted (activity heartbeat)
  lastActivityAt        DateTime?
  // LIVE-11: SessionExerciseSubstitution[] — exercises performed in place of
  // routine slots. The snapshot keeps the prescription; this keeps the swap.
  exerciseSubstitutions Json                    @default("[]")
  // LIVE-16: SessionExerciseNote[] -- the owner's note per exercise slot for
  // this workout. The routine's own exercise note is never written from here.
  exerciseNotes         Json                    @default("[]")
  // ROUT-15: the training block this session trained, copied at start so a
  // later revision, the block's end or its deletion never rewrites it. All
  // null when the session trained the routine's baseline.
  trainingBlockId       String?
  trainingBlockSeriesId String?
  trainingBlockRevision Int?
  trainingBlockName     String?                 @db.VarChar(60)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  shares          SessionShare[]
  notifications   Notification[]
  corrections     SessionCorrection[]
  /// At most one in practice: the `rest:<sessionId>` dedupe key enforces it.
  /// The relation is one-to-many because `sessionId` is no longer unique.
  scheduledPushes ScheduledPush[]

  @@index([userId, status, startedAt])
  @@index([userId, id])
  @@index([userId, status, endedAt, id], map: "workout_analytics_cursor_status")
  @@index([userId, sourceRoutineDayId, status, endedAt(sort: Desc), id(sort: Desc)], map: "workout_previous_performance")
  @@index([lastActivityAt])
  @@index([routineId, trainingBlockSeriesId, status, endedAt])
}

// SOC-07: an owner-created, revocable public link to selected parts of one
// completed session's recap. `fields` holds SessionShareField values from
// @sunsteel/contracts; the service validates them on write.
/// ROUT-04: a revocable link to one routine. The token is the only credential,
/// exactly as in SOC-07, and revocation is permanent.
model RoutineShare {
  id        String    @id @default(uuid())
  token     String    @unique @db.VarChar(64)
  routineId String
  routine   Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([routineId, revokedAt])
  @@index([userId])
}

model SessionShare {
  id                 String         @id @default(uuid())
  token              String         @unique @db.VarChar(64)
  sessionId          String
  session            WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields             String[]
  createdAt          DateTime       @default(now())
  revokedAt          DateTime?
  /// TRUST-04: set by HIDE_SUBJECT. The token stops resolving; the link is
  /// not revoked and the session is untouched, so the owner can be told the
  /// difference and a restore puts it back exactly as it was.
  moderationHiddenAt DateTime?

  @@index([sessionId, revokedAt])
  @@index([userId])
}

/// LIVE-17: one saved correction of a finished workout's set logs. Written
/// once and never updated or deleted -- the before and after values in
/// `changes` (contracts `SessionSetCorrection[]`) are the audit trail, so a
/// second correction appends another row rather than editing this one.
model SessionCorrection {
  id        String         @id @default(uuid())
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  changes   Json
  createdAt DateTime       @default(now())

  @@index([sessionId, createdAt])
  @@index([userId])
}

// A log of an executed set during a workout session
model SetLog {
  sourceRoutineExerciseId String?
  id                      String           @id @default(uuid())
  sessionId               String
  session                 WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  routineExerciseId       String?
  routineExercise         RoutineExercise? @relation(fields: [routineExerciseId], references: [id], onDelete: SetNull)
  exerciseId              String
  exercise                Exercise         @relation(fields: [exerciseId], references: [id])
  setNumber               Int
  reps                    Int?
  weight                  Float?
  rpe                     Float?
  isCompleted             Boolean          @default(false)
  completedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, routineExerciseId, setNumber])
  @@unique([sessionId, sourceRoutineExerciseId, setNumber])
  @@index([sessionId])
}

model WorkoutSessionSnapshot {
  sessionId     String         @id
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schemaVersion Int            @default(1)
  payload       Json
  provenance    String
  createdAt     DateTime       @default(now())
}

model TrainingEvent {
  id            String            @id @default(uuid())
  eventKey      String            @unique
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String?
  type          TrainingEventType
  occurredAt    DateTime
  schemaVersion Int               @default(1)
  payload       Json

  @@index([userId, occurredAt, id])
  // Created by hand in 20260914103000_milestone_achievements and never
  // declared here, so every later migration proposed dropping it. The
  // achievements and timeline reads walk it; declaring it ends the drift.
  @@index([userId, type, occurredAt(sort: Desc), id(sort: Desc)], map: "training_event_user_type_occurred")
}

enum TrainingEventType {
  SESSION_COMPLETED
  PERSONAL_RECORD
  PROGRESSION_CHANGED
  STREAK_MILESTONE
  ACHIEVEMENT_UNLOCKED
}

model PersonalRecord {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId   String
  exerciseName String
  sessionId    String
  setLogId     String
  weight       Float
  reps         Int
  estimated1rm Float
  achievedAt   DateTime

  @@unique([userId, exerciseId])
  @@index([userId, achievedAt(sort: Desc)])
}

model WorkoutAnalyticsProjection {
  id                String                    @id @default(uuid())
  userId            String
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemaVersion     Int                       @default(1)
  timeZone          String
  state             String                    @default("BUILDING")
  active            Boolean                   @default(false)
  totalVolumeKg     Float                     @default(0)
  completedSessions Int                       @default(0)
  completedSets     Int                       @default(0)
  lastTrainingDate  String?
  currentRun        Int                       @default(0)
  bestRun           Int                       @default(0)
  checksum          String                    @default("")
  createdAt         DateTime                  @default(now())
  rollups           WorkoutRollup[]
  muscleRollups     WorkoutMuscleRollup[]
  job               AnalyticsBackfillJob?
  recordFrontier    AnalyticsRecordFrontier[]

  @@index([userId, createdAt(sort: Desc)])
}

model WorkoutRollup {
  projectionId  String
  projection    WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  period        String
  date          String
  volumeKg      Float                      @default(0)
  completedSets Int                        @default(0)
  sessions      Int                        @default(0)
  activeDays    Int                        @default(0)

  @@id([projectionId, period, date])
}

model AnalyticsRecordFrontier {
  projectionId String
  projection   WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  exerciseId   String
  weight       Float
  reps         Int

  @@id([projectionId, exerciseId])
}

model WorkoutMuscleRollup {
  projectionId  String
  projection    WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  period        String
  date          String
  muscle        String
  volumeKg      Float                      @default(0)
  completedSets Float                      @default(0)

  @@id([projectionId, period, date, muscle])
}

model AnalyticsBackfillJob {
  id                      String                     @id @default(uuid())
  projectionId            String                     @unique
  projection              WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  state                   String                     @default("PENDING")
  cursorEndedAt           DateTime?
  cursorSessionId         String?
  snapshotCursorSessionId String?
  snapshotsComplete       Boolean                    @default(false)
  attempts                Int                        @default(0)
  error                   String?
  approximatedSessions    Int                        @default(0)
  processedSessions       Int                        @default(0)
  updatedAt               DateTime                   @updatedAt

  @@index([state, updatedAt])
}

// NOTIF-01: the in-app notification center. Rows are gathered on read from
// records that already exist (training events and follows), keyed by their
// source, so gathering again never duplicates one.
enum NotificationKind {
  ACHIEVEMENT
  SESSION_PROGRESS
  NEW_FOLLOWER
  /// SOC-06: the first kind another member causes on purpose.
  ACTIVITY_COMMENT
  /// SOC-09: one of four fixed prompts from an allowed training partner.
  TRAINING_PARTNER_ENCOURAGEMENT
}

/// NOTIF-08: one subscribed browser on one device. The endpoint is the
/// capability to push to it, so it is unique and never returned to a client.
model PushSubscription {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String   @unique
  p256dh         String
  auth           String
  /// The browser's own expiry; almost always null.
  expirationTime BigInt?
  /// A short label derived by the client, so the owner recognises the device.
  deviceLabel    String?
  createdAt      DateTime @default(now())
  /// Refreshed whenever the same endpoint registers again.
  lastSeenAt     DateTime @default(now())

  @@index([userId, lastSeenAt])
}

/// NOTIF-03: one pending alert per session. A new rest period replaces the
/// last, and the row is deleted once sent or cancelled, so nothing accumulates.
model ScheduledPush {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What this pending push is for, unique so re-planning replaces rather than
  /// duplicates: `rest:<sessionId>` for NOTIF-03, `reminder:<date>` for
  /// NOTIF-04. It replaced a unique `sessionId`, which a reminder has none of.
  dedupeKey String          @unique
  /// Only a rest alert belongs to a session; a reminder is for a whole date.
  sessionId String?
  session   WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payload   Json
  /// Second-level precision; the sweep sends every row already due.
  sendAt    DateTime
  createdAt DateTime        @default(now())

  @@index([sendAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  sourceKey String
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  sessionId String?
  session   WorkoutSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payload   Json
  /// When the announced thing happened, not when it was gathered.
  createdAt DateTime
  readAt    DateTime?

  @@unique([userId, sourceKey])
  @@index([userId, createdAt])
}

/// SOC-03/SOC-04: the activity types a member can share. Entries are
/// generated on read from verified data; only the owner's choices are stored.
enum ActivityType {
  SESSION_COMPLETED
  PERSONAL_RECORD
  PROGRESSION_CHANGED
  ACHIEVEMENT_UNLOCKED
  STREAK_MILESTONE
  COMEBACK
  ROUTINE_SHARED
}

/// SOC-04: the default audience of one activity type. A missing row is
/// PRIVATE, so nothing reaches anyone until its owner chooses.
model ActivitySharingDefault {
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ActivityType
  audience  ProfileVisibility
  updatedAt DateTime          @updatedAt

  @@id([userId, type])
}

/// SOC-04: one entry's own audience, keyed by the entry's stable source key.
/// PRIVATE withdraws it. The section rule still caps whatever is stored here.
model ActivityEntryOverride {
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryKey  String            @db.VarChar(200)
  type      ActivityType
  audience  ProfileVisibility
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@id([userId, entryKey])
  @@index([userId, type])
}

/// SOC-05: the four themed reactions. They acknowledge one activity entry and
/// nothing else: no total counts them and nothing is ordered by them.
enum ActivityReaction {
  STRENGTH
  DISCIPLINE
  RESPECT
  INSPIRING
}

/// SOC-05: one member's reaction to one activity entry. The primary key is
/// the pair, so choosing another replaces it and there is nothing to
/// accumulate. `authorId` is the entry's owner, resolved when the reaction is
/// accepted: the read needs it to group by author, and a key belongs to one
/// author by construction.
/// SOC-06: a comment on one generated activity entry.
///
/// Keyed by the same stable `entryKey` a SOC-05 reaction uses, because SOC-03
/// entries are generated on read and never stored -- that key is the only
/// identity an activity has. `authorId` is the entry's owner, resolved and
/// stored when the comment is accepted, so the read that lists comments and the
/// notification that announces one both know who they belong to without
/// re-deriving the entry.
///
/// Unlike a reaction there may be many per member per entry, so it has its own
/// id. Deleting is a real delete: nothing else in the product reads these rows,
/// so there is nothing a tombstone would protect.
model ActivityComment {
  id                 String    @id @default(uuid())
  entryKey           String    @db.VarChar(200)
  /// Who wrote it.
  userId             String
  user               User      @relation("ActivityCommentsMade", fields: [userId], references: [id], onDelete: Cascade)
  /// Whose activity it is attached to; they may delete it as well.
  authorId           String
  author             User      @relation("ActivityCommentsReceived", fields: [authorId], references: [id], onDelete: Cascade)
  body               String    @db.VarChar(500)
  /// TRUST-04: set by HIDE_SUBJECT. Gone for everyone but its writer; the row
  /// and its text are untouched, exactly as a hidden routine keeps its days.
  moderationHiddenAt DateTime?
  createdAt          DateTime  @default(now())

  @@index([entryKey, createdAt, id])
  @@index([authorId, createdAt])
  @@index([userId, createdAt])
}

model ActivityEntryReaction {
  userId    String
  user      User             @relation("ActivityReactionsMade", fields: [userId], references: [id], onDelete: Cascade)
  entryKey  String           @db.VarChar(200)
  authorId  String
  author    User             @relation("ActivityReactionsReceived", fields: [authorId], references: [id], onDelete: Cascade)
  reaction  ActivityReaction
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@id([userId, entryKey])
  @@index([entryKey])
  @@index([authorId, entryKey])
}
