// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  analyticsProjectionId      String?
  timeZone                   String?
  analyticsProjections       WorkoutAnalyticsProjection[]
  trainingEvents             TrainingEvent[]
  personalRecords            PersonalRecord[]
  id                         String                       @id @default(uuid())
  email                      String                       @unique
  username                   String                       @unique @db.VarChar(30)
  password                   String? // Made optional for Supabase migration
  name                       String
  lastName                   String?
  avatarUrl                  String?
  bio                        String?                      @db.VarChar(500)
  location                   String?                      @db.VarChar(100)
  trainingGoals              TrainingGoal[]               @default([])
  trainingExperienceLevel    TrainingExperienceLevel?
  trainingDisciplines        TrainingDiscipline[]         @default([])
  preferredTrainingStyle     PreferredTrainingStyle?
  age                        Int?
  sex                        Sex?
  weight                     Float?
  height                     Float?
  supabaseUserId             String?                      @unique // Link to Supabase user
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  refreshTokens              RefreshToken[]
  weightUnit                 WeightUnit                   @default(KG)
  bioVisibility              ProfileVisibility            @default(PRIVATE)
  locationVisibility         ProfileVisibility            @default(PRIVATE)
  trainingIdentityVisibility ProfileVisibility            @default(PRIVATE)
  historyVisibility          ProfileVisibility            @default(PRIVATE)
  recordsVisibility          ProfileVisibility            @default(PRIVATE)
  routinesVisibility         ProfileVisibility            @default(PRIVATE)
  achievementsVisibility     ProfileVisibility            @default(PRIVATE)
  bodyMetricsVisibility      ProfileVisibility            @default(PRIVATE)
  discoverableByName         Boolean                      @default(true)
  discoverableByUsername     Boolean                      @default(true)
  discoverableByContacts     Boolean                      @default(false)
  // PREF-05: sessions without a new best before the plateau watch flags a
  // lift; bounded by PLATEAU_MIN_SESSIONS_MIN/MAX (checked in the migration).
  plateauMinSessions         Int                          @default(4)
  routines                   Routine[]
  workoutSessions            WorkoutSession[]
  trainingLocations          TrainingLocationPreference[]
  following                  UserFollow[]                 @relation("UserFollowing")
  followers                  UserFollow[]                 @relation("UserFollowers")
  favoriteExercises          UserFavoriteExercise[]
  starredExercises           StarredExercise[]
  sessionShares              SessionShare[]
  measurableGoals            MeasurableGoal[]
  scheduleOverrides          ScheduleOverride[]
}

model TrainingLocationPreference {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  isDefault           Boolean  @default(false)
  barWeightKg         Float
  availablePlatePairs Json     @default("[]")
  equipment           String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, isDefault])
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("Follow")
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  issuedAt  DateTime @default(now())
  expiresAt DateTime
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt  DateTime @default(now())
  expiresAt DateTime
}

// Weight unit preference per user
enum WeightUnit {
  KG
  LB
}

// Biological sex of user
enum Sex {
  MALE
  FEMALE
}

enum ProfileVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum TrainingGoal {
  STRENGTH
  MUSCLE_GROWTH
  FAT_LOSS
  ENDURANCE
  GENERAL_FITNESS
  ATHLETIC_PERFORMANCE
  MOBILITY
}

enum TrainingExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingDiscipline {
  BODYBUILDING
  POWERLIFTING
  WEIGHTLIFTING
  CALISTHENICS
  STRONGMAN
  HYBRID_TRAINING
  GENERAL_STRENGTH
}

enum PreferredTrainingStyle {
  FULL_BODY
  UPPER_LOWER
  PUSH_PULL_LEGS
  BODY_PART_SPLIT
  CIRCUIT
}

// Muscle groups for exercise targeting
enum MuscleGroup {
  PECTORAL
  LATISSIMUS_DORSI
  TRAPEZIUS
  REAR_DELTOIDS
  ERECTOR_SPINAE
  TERES_MAJOR_MINOR
  ANTERIOR_DELTOIDS
  MEDIAL_DELTOIDS
  BICEPS
  FOREARMS
  TRICEPS
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE
  ADDUCTOR
}

// EXER-09: how an exercise moves. Mirrors MOVEMENT_PATTERNS in @sunsteel/contracts.
enum MovementPattern {
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  SQUAT
  HINGE
  LUNGE
  CHEST_FLY
  SHOULDER_ABDUCTION
  SHOULDER_FLEXION
  SHOULDER_HORIZONTAL_ABDUCTION
  SHOULDER_EXTENSION
  SCAPULAR_ELEVATION
  ELBOW_FLEXION
  ELBOW_EXTENSION
  KNEE_EXTENSION
  KNEE_FLEXION
  HIP_EXTENSION
  PLANTAR_FLEXION
  CORE_FLEXION
  CORE_ROTATION
  CORE_STABILITY
}

enum ExerciseMechanic {
  COMPOUND
  ISOLATION
}

// Catalog of exercises selectable when building routines
model Exercise {
  id                String                 @id @default(uuid())
  name              String                 @unique
  primaryMuscles    MuscleGroup[] // Primary muscle movers (counts as 1.0 for volume)
  secondaryMuscles  MuscleGroup[] // Secondary muscle movers (counts as 0.5 for volume)
  equipment         String // e.g., "barbell", "dumbbell", "bodyweight"
  // EXER-09 metadata; the catalog values live in prisma/exercise-catalog.ts.
  movementPattern   MovementPattern?
  mechanic          ExerciseMechanic?
  equipmentRequired String[]               @default([]) // EXERCISE_EQUIPMENT values
  substitutionGroup String?
  instructions      String[]               @default([]) // EXER-03 content
  mediaUrl          String? // EXER-04 licensed media
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  routineExercises  RoutineExercise[]
  setLogs           SetLog[]
  favoritedBy       UserFavoriteExercise[]
  starredBy         StarredExercise[]
  measurableGoals   MeasurableGoal[]

  @@index([movementPattern])
  @@index([substitutionGroup])
}

enum MeasurableGoalType {
  WEEKLY_SESSIONS
  WEEKLY_VOLUME
  STREAK_DAYS
  EXERCISE_ESTIMATED_1RM
  BODY_WEIGHT
}

enum MeasurableGoalDirection {
  AT_LEAST
  AT_MOST
}

model MeasurableGoal {
  id          String                  @id @default(uuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        MeasurableGoalType
  targetValue Float
  direction   MeasurableGoalDirection @default(AT_LEAST)
  exerciseId  String?
  exercise    Exercise?               @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([exerciseId])
}

model UserFavoriteExercise {
  userId     String
  exerciseId String
  position   Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
  @@index([userId, position])
  @@index([exerciseId])
}

// EXER-07: private stars that order the owner's exercise pickers. Separate
// from UserFavoriteExercise, the public training-identity favorites.
model StarredExercise {
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
  @@index([userId, createdAt])
  @@index([exerciseId])
}

// A training routine owned by a single user (non-shareable for now)
model Routine {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  isPeriodized      Boolean             @default(false)
  isFavorite        Boolean             @default(false)
  isCompleted       Boolean             @default(false)
  // ROUT-11: WEEKLY days carry a weekday; ROTATION days run in `order`.
  scheduleMode      RoutineScheduleMode @default(WEEKLY)
  // SCHED-07: planned rest weekdays of a weekly routine (never training days).
  restDays          Int[]               @default([])
  // SCHED-06: weekdays a ROTATION routine trains on; empty means any day, undated.
  rotationWeekdays  Int[]               @default([])
  // ROUT-08: the last version number handed out, so deleted numbers are never reused.
  lastVersionNumber Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  days              RoutineDay[]
  workoutSessions   WorkoutSession[]
  versions          RoutineVersion[]
  scheduleOverrides ScheduleOverride[]

  @@index([userId, isFavorite])
  @@index([userId, isCompleted])
}

enum RoutineScheduleMode {
  WEEKLY
  ROTATION
}

// ROUT-08: an immutable copy of a routine's whole setup (contracts
// `RoutineVersionSetup`), saved on purpose or just before a restore.
model RoutineVersion {
  id                    String             @id @default(uuid())
  routineId             String
  routine               Routine            @relation(fields: [routineId], references: [id], onDelete: Cascade)
  // 1, 2, 3… per routine, never reused after a deletion.
  number                Int
  name                  String?            @db.VarChar(60)
  kind                  RoutineVersionKind @default(SAVED)
  // BEFORE_RESTORE only: the number of the version that was restored.
  restoredVersionNumber Int?
  setup                 Json
  createdAt             DateTime           @default(now())

  @@unique([routineId, number])
}

enum RoutineVersionKind {
  SAVED
  BEFORE_RESTORE
}

// SCHED-04: the schedule-instance model — per-date overrides of a routine's
// plan, kept by calendar date (YYYY-MM-DD) because routine edits replace the
// days. MOVE puts one weekly occurrence on `toDate`.
model ScheduleOverride {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId String
  routine   Routine              @relation(fields: [routineId], references: [id], onDelete: Cascade)
  date      String               @db.VarChar(10)
  kind      ScheduleOverrideKind @default(MOVE)
  toDate    String?              @db.VarChar(10)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([routineId, date])
  @@index([userId, date])
  @@index([userId, toDate])
}

enum ScheduleOverrideKind {
  MOVE
}

// A training day configuration inside a routine
model RoutineDay {
  id              String            @id @default(uuid())
  routineId       String
  routine         Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dayOfWeek       Int? // 0=Sun .. 6=Sat on WEEKLY routines; null on ROTATION
  name            String?           @db.VarChar(40)
  order           Int               @default(0)
  exercises       RoutineExercise[]
  workoutSessions WorkoutSession[]

  @@unique([routineId, dayOfWeek])
}

// One exercise entry in a routine day
model RoutineExercise {
  id                 String               @id @default(uuid())
  routineDayId       String
  routineDay         RoutineDay           @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exerciseId         String
  exercise           Exercise             @relation(fields: [exerciseId], references: [id])
  order              Int                  @default(0)
  restSeconds        Int                  @default(60)
  note               String? // User note for the exercise in this routine
  // Progression configuration per exercise
  progressionScheme  ProgressionScheme    @default(NONE)
  minWeightIncrement Float                @default(2.5)
  sets               RoutineExerciseSet[]
  setLogs            SetLog[]
}

// Set configuration for a routine exercise
model RoutineExerciseSet {
  id                String          @id @default(uuid())
  routineExerciseId String
  routineExercise   RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  // Rep prescription can be a fixed amount or a range
  repType           RepType         @default(FIXED)
  reps              Int?
  minReps           Int?
  maxReps           Int?
  weight            Float?
  rir               Int?

  @@unique([routineExerciseId, setNumber])
}

// How reps are prescribed for a set
enum RepType {
  FIXED
  RANGE
}

// How weight progression should be applied for an exercise
enum ProgressionScheme {
  NONE // no progression applied
  DOUBLE_PROGRESSION // progress when all sets hit target (formerly DYNAMIC)
  DYNAMIC_DOUBLE_PROGRESSION // progress per set when that set hits target (formerly DYNAMIC_DOUBLE)
}

// Tracking a user's execution of a specific RoutineDay
enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

model WorkoutSession {
  sourceRoutineId       String?
  sourceRoutineDayId    String?
  totalVolumeKg         Float?
  completedSets         Int?
  snapshot              WorkoutSessionSnapshot?
  id                    String                  @id @default(uuid())
  userId                String
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId             String?
  routine               Routine?                @relation(fields: [routineId], references: [id], onDelete: SetNull)
  routineDayId          String?
  routineDay            RoutineDay?             @relation(fields: [routineDayId], references: [id], onDelete: SetNull)
  status                WorkoutSessionStatus    @default(IN_PROGRESS)
  startedAt             DateTime                @default(now())
  endedAt               DateTime?
  durationSec           Int?
  notes                 String?
  setLogs               SetLog[]
  // Updated whenever a set log is created/updated/deleted (activity heartbeat)
  lastActivityAt        DateTime?
  // LIVE-11: SessionExerciseSubstitution[] — exercises performed in place of
  // routine slots. The snapshot keeps the prescription; this keeps the swap.
  exerciseSubstitutions Json                    @default("[]")

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  shares    SessionShare[]

  @@index([userId, status, startedAt])
  @@index([userId, id])
  @@index([userId, status, endedAt, id], map: "workout_analytics_cursor_status")
  @@index([userId, sourceRoutineDayId, status, endedAt(sort: Desc), id(sort: Desc)], map: "workout_previous_performance")
  @@index([lastActivityAt])
}

// SOC-07: an owner-created, revocable public link to selected parts of one
// completed session's recap. `fields` holds SessionShareField values from
// @sunsteel/contracts; the service validates them on write.
model SessionShare {
  id        String         @id @default(uuid())
  token     String         @unique @db.VarChar(64)
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields    String[]
  createdAt DateTime       @default(now())
  revokedAt DateTime?

  @@index([sessionId, revokedAt])
  @@index([userId])
}

// A log of an executed set during a workout session
model SetLog {
  sourceRoutineExerciseId String?
  id                      String           @id @default(uuid())
  sessionId               String
  session                 WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  routineExerciseId       String?
  routineExercise         RoutineExercise? @relation(fields: [routineExerciseId], references: [id], onDelete: SetNull)
  exerciseId              String
  exercise                Exercise         @relation(fields: [exerciseId], references: [id])
  setNumber               Int
  reps                    Int?
  weight                  Float?
  rpe                     Float?
  isCompleted             Boolean          @default(false)
  completedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, routineExerciseId, setNumber])
  @@unique([sessionId, sourceRoutineExerciseId, setNumber])
  @@index([sessionId])
}

model WorkoutSessionSnapshot {
  sessionId     String         @id
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schemaVersion Int            @default(1)
  payload       Json
  provenance    String
  createdAt     DateTime       @default(now())
}

model TrainingEvent {
  id            String            @id @default(uuid())
  eventKey      String            @unique
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String?
  type          TrainingEventType
  occurredAt    DateTime
  schemaVersion Int               @default(1)
  payload       Json

  @@index([userId, occurredAt, id])
}

enum TrainingEventType {
  SESSION_COMPLETED
  PERSONAL_RECORD
  PROGRESSION_CHANGED
  STREAK_MILESTONE
  ACHIEVEMENT_UNLOCKED
}

model PersonalRecord {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId   String
  exerciseName String
  sessionId    String
  setLogId     String
  weight       Float
  reps         Int
  estimated1rm Float
  achievedAt   DateTime

  @@unique([userId, exerciseId])
  @@index([userId, achievedAt(sort: Desc)])
}

model WorkoutAnalyticsProjection {
  id                String                    @id @default(uuid())
  userId            String
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemaVersion     Int                       @default(1)
  timeZone          String
  state             String                    @default("BUILDING")
  active            Boolean                   @default(false)
  totalVolumeKg     Float                     @default(0)
  completedSessions Int                       @default(0)
  completedSets     Int                       @default(0)
  lastTrainingDate  String?
  currentRun        Int                       @default(0)
  bestRun           Int                       @default(0)
  checksum          String                    @default("")
  createdAt         DateTime                  @default(now())
  rollups           WorkoutRollup[]
  muscleRollups     WorkoutMuscleRollup[]
  job               AnalyticsBackfillJob?
  recordFrontier    AnalyticsRecordFrontier[]

  @@index([userId, createdAt(sort: Desc)])
}

model WorkoutRollup {
  projectionId  String
  projection    WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  period        String
  date          String
  volumeKg      Float                      @default(0)
  completedSets Int                        @default(0)
  sessions      Int                        @default(0)
  activeDays    Int                        @default(0)

  @@id([projectionId, period, date])
}

model AnalyticsRecordFrontier {
  projectionId String
  projection   WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  exerciseId   String
  weight       Float
  reps         Int

  @@id([projectionId, exerciseId])
}

model WorkoutMuscleRollup {
  projectionId  String
  projection    WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  period        String
  date          String
  muscle        String
  volumeKg      Float                      @default(0)
  completedSets Float                      @default(0)

  @@id([projectionId, period, date, muscle])
}

model AnalyticsBackfillJob {
  id                      String                     @id @default(uuid())
  projectionId            String                     @unique
  projection              WorkoutAnalyticsProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  state                   String                     @default("PENDING")
  cursorEndedAt           DateTime?
  cursorSessionId         String?
  snapshotCursorSessionId String?
  snapshotsComplete       Boolean                    @default(false)
  attempts                Int                        @default(0)
  error                   String?
  approximatedSessions    Int                        @default(0)
  processedSessions       Int                        @default(0)
  updatedAt               DateTime                   @updatedAt

  @@index([state, updatedAt])
}
